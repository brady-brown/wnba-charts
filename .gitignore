# Local environment
.venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.DS_Store

# ---------------------------------------------------------------------------
# API cache
# ---------------------------------------------------------------------------
# data/cache/ is ~615 MB, almost all of it raw play-by-play and shot
# coordinates for seasons that will never change again. Those are rebuildable
# from the league feed and belong in the CI cache, not in git history.
#
# What IS committed is the small metadata the site build needs to run OFFLINE:
# team identity, the schedule index it stamps builds from, and the benchmark
# feeds. Without these a fresh clone cannot build the site at all — it would
# have to re-pull thirty seasons to learn what the Utah Starzz were called.
data/cache/*
!data/cache/teams/
!data/cache/game_ids_*.csv
!data/cache/team_ratings_*.csv
!data/cache/box_score_*.csv
!data/cache/player_stats_*.csv

# Superseded: GameRotation is no longer part of the pipeline (data/pbp_rotation.py
# reproduces it from play-by-play), and the cached frames are home/away inverted.
data/cache/rotation_*.csv

# Exploratory output, regenerated by archetypes.py on demand
archetypes_*.png
archetypes_results.csv
